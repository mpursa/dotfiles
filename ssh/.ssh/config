# Machine-specific and work hosts, untracked. First match wins, so it goes first.
Include ~/.ssh/config.local

Host piserver piserver.local
  HostName piserver.local
  User mpursa

Host vps vps.mpursa.com
  HostName 10.10.10.1
  User mpursa
  Port 2222
  IdentityFile ~/.ssh/id_ed25519

# Defaults for every host: keep last
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
