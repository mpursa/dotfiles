    {
      "description": "Alt+Tab switches apps like Windows (hold Alt, tap Tab; Shift goes back)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "to_if_other_key_pressed": [
            {
              "other_keys": [
                {
                  "key_code": "tab",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                }
              ],
              "to": [
                {
                  "key_code": "left_command"
                }
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
